# Project Configuration
PROJECT_NAME=hevy
ENVIRONMENT=development
DEBUG=False

# Logging Configuration
# LOG_LEVEL controls the log/ file; LOG_CONSOLE_LEVEL controls terminal noise.
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=CRITICAL

# Hevy API
# Get your key from https://hevy.com/settings?developer (Hevy Pro required)
HEVY_API_KEY=
HEVY_API_BASE_URL=https://api.hevyapp.com
